# No model or judge credential should be committed.
# Private contracts, progress probes, and run artifacts live outside this
# repository (see docs/evaluation.md). These variables are host-local only.
HARBOR_HOME=
RETREATBENCH_ARTIFACT_ROOT=./artifacts
RETREATBENCH_PRIVATE_CONTRACT_ROOT=./contracts/private

# `retreatbench detect` judge/arbiter credentials (loaded via --env-file, never merged into
# this process's own environment). This is a separate credential/spend surface from whatever
# the subject agent uses inside Harbor -- do not assume it's safe to reuse the exact same key
# for both roles. Both pairs are Apex-compatible endpoints already validated for Harbor's own
# agent env-var passthrough; see docs/evaluation.md.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
